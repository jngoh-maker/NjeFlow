#!/bin/sh
### BEGIN INIT INFO
# Provides:          njeflow
# Required-Start:    $remote_fs $network
# Required-Stop:     $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: NjeFlow Node.js app
### END INIT INFO
#
# Installed to /etc/init.d/njeflow by web-setup.sh (Web01 and Web02).
# Usage: sudo service njeflow {start|stop|restart|status}

NAME=njeflow
APP_DIR=/var/www/njeflow
APP_USER=njeflow
NODE_BIN=/usr/bin/node
PIDFILE=/var/run/$NAME.pid
LOGFILE=/var/log/$NAME.log

# Node only listens locally; Nginx on port 80 forwards to it
export NODE_ENV=production
export HOST=127.0.0.1
export PORT=3000

is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
    if is_running; then
        echo "$NAME is already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    echo "Starting $NAME..."
    touch "$LOGFILE"
    chown "$APP_USER:$APP_USER" "$LOGFILE"
    start-stop-daemon --start --background \
        --make-pidfile --pidfile "$PIDFILE" \
        --chuid "$APP_USER" --chdir "$APP_DIR" \
        --startas /bin/sh -- -c "exec $NODE_BIN server.js >> $LOGFILE 2>&1"
    sleep 1
    if is_running; then
        echo "$NAME started (pid $(cat "$PIDFILE"))"
    else
        echo "$NAME failed to start. See $LOGFILE"
        return 1
    fi
}

stop() {
    if ! is_running; then
        echo "$NAME is not running"
        rm -f "$PIDFILE"
        return 0
    fi
    echo "Stopping $NAME..."
    start-stop-daemon --stop --pidfile "$PIDFILE" --retry TERM/10/KILL/5 >/dev/null
    rm -f "$PIDFILE"
    echo "$NAME stopped"
}

status() {
    if is_running; then
        echo "$NAME is running (pid $(cat "$PIDFILE"))"
    else
        echo "$NAME is not running"
        return 3
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    status)  status ;;
    *)       echo "Usage: service $NAME {start|stop|restart|status}"; exit 1 ;;
esac
